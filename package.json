{
  "name": "pwa-extension-monorepo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev:pwa": "pnpm -F pwa dev",
    "dev:ext": "pnpm -F extension dev",
    "build:pwa": "pnpm -F pwa build",
    "build:ext": "pnpm -F extension build",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "hook:pre-commit": "pnpm format && pnpm lint && pnpm check && pnpm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm -r check",
    "changelog": "git-cliff --tag ${npm_package_version:-unreleased} -o CHANGELOG.md",
    "release": "node scripts/release-version.mjs",
    "version": "pnpm changelog && git add CHANGELOG.md"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "git-cliff": "^2.13.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "typescript-eslint": "^8.59.1"
  }
}
